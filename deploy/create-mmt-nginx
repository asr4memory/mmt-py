#!/bin/bash

[[ $# -eq 1 ]] || {
    echo "usage: create-mmt-nginx TAG"
    exit 1
}

image="ghcr.io/asr4memory/mmt-nginx:$1"
container="mmt-nginx"
data_dir="${MMT_DATA_DIR:?set MMT_DATA_DIR to the host user-files directory}"
http_port="${MMT_HTTP_PORT:?set MMT_HTTP_PORT to the host port for HTTP}"
https_port="${MMT_HTTPS_PORT:?set MMT_HTTPS_PORT to the host port for HTTPS}"
tls_dir="${MMT_TLS_DIR:?set MMT_TLS_DIR to the host directory with fullchain.pem and privkey.pem}"
echo "Running image $image as $container ..."

# The proxy reaches the web app as mmt-app-web on the mmt network.
podman run \
       --restart always \
       --detach \
       --network mmt \
       --publish "$http_port:8080" \
       --publish "$https_port:8443" \
       --volume "$data_dir:/srv/user_files:ro" \
       --volume "$tls_dir:/etc/nginx/tls:ro" \
       --name="$container" \
       "$image"
