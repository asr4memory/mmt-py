# mariadb.env holds MARIADB_ROOT_PASSWORD and MARIADB_PASSWORD, the password of
# the user mmt, which is also DATABASE_PASSWORD in app.env. It is not committed.

[Unit]
Description=MMT database

[Container]
ContainerName=mmt-mariadb
Image=docker.io/library/mariadb:11
Network=mmt.network
Volume=mmt-mariadb.volume:/var/lib/mysql
Environment=MARIADB_DATABASE=mmt
Environment=MARIADB_USER=mmt
EnvironmentFile=%h/mmt/mariadb.env
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
