# https://django-environ.readthedocs.io/en/latest/index.html
DJANGO_ENV=development
DJANGO_RUNSERVER_HIDE_WARNING=true
DEBUG=off
# Create secret key with:
# python manage.py shell -c 'from django.core.management import utils; print(utils.get_random_secret_key())'
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=example.com,www.example.com
DATABASE_URL=mysql://root:password@localhost/mmt
# CACHE_URL=memcache://127.0.0.1:11211,127.0.0.1:11212,127.0.0.1:11213
# REDIS_URL=rediscache://127.0.0.1:6379/1?client_class=django_redis.client.DefaultClient&password=ungithubbed-secret
EMAIL_URL=consolemail://
EMAIL_FROM=bob@example.com
CELERY_BROKER_URL=redis://localhost
# Sentry error tracking URL (optional)
SENTRY_URL=
CSP_REPORT_URI=
OPENID_CONNECT_SERVER_URL=http://portal.oral-history.localhost:3000
OPENID_CONNECT_SECRET=secret
