#: mmt/my_account/templates/user_activated.txt:4
msgid ""
"Thank you for registering with the Media Management Tool (MMT) - the "
"application for file uploads and downloads on the Oral-History.Digital "
"platform."
msgstr ""
"vielen Dank für die Registrierung beim Media Management Tool (MMT) - der "
"Anwendung für Datei-Uploads und -Downloads auf der Oral-History.Digital-"
"Plattform."

#: mmt/my_account/templates/user_activated.txt:6
#, python-format
