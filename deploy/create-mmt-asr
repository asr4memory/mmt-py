#!/bin/bash

# Copy this script to the server and set these values for the host.
asr_port=8001                             # host port of the ASR service
media_root=/srv/mmt/media                 # shared media storage, mounted read-only
models_file=/srv/mmt-asr/models.toml      # model registry
models_dir=/srv/mmt-asr/models            # local model directories
hf_token=                                 # gated diarization models; empty disables diarization

[[ $# -eq 1 ]] || {
    echo "usage: create-mmt-asr TAG"
    exit 1
}

image="ghcr.io/asr4memory/mmt-asr:$1"
container="mmt-asr"
echo "Running image $image as $container ..."

docker volume inspect mmt-asr-spool >/dev/null 2>&1 || docker volume create mmt-asr-spool
docker volume inspect mmt-asr-models >/dev/null 2>&1 || docker volume create mmt-asr-models

docker run \
       --restart always \
       --init \
       --detach \
       --device nvidia.com/gpu=all \
       --health-cmd 'curl -fsS http://localhost:8000/health' \
       --health-interval 30s \
       --health-timeout 30s \
       --health-start-period 120s \
       --health-retries 3 \
       --publish "$asr_port:8000" \
       --volume mmt-asr-spool:/spool \
       --volume mmt-asr-models:/model_cache \
       --volume "$media_root:/media_root:ro" \
       --volume "$models_file:/etc/mmt-asr/models.toml:ro" \
       --volume "$models_dir:/models:ro" \
       --env MEDIA_ROOT=/media_root \
       --env SPOOL_DIR=/spool \
       --env HF_TOKEN="$hf_token" \
       --name="$container" \
       "$image"
