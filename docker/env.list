# Common environment variables loaded by all containers.
CELERY_BROKER_URL=redis://redis
DATABASE_NAME=mmt
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=3306
ASR_API_URL=http://asr:8000
NER_API_URL=http://ner:8000
DJANGO_ENV=production
ALLOWED_HOSTS=127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1
EMAIL_FROM=bob@example.com
EMAIL_HOST=mail.example.com
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
PGID=101
PUID=100
SECRET_KEY=secret-key
SENTRY_URL=
SILK_ENABLED=false
OPENID_CONNECT_SERVER_URL=https://sso.example.com
OPENID_CONNECT_SECRET=secret
TMPDIR=/app/django-app/user_files/_tmp
X_ACCEL_LOCATION=/internal-media/
