{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["assets/js/**/*"]
}
