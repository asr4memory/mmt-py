# The values are examples and must be adjusted on the host.

[Unit]
Description=MMT reverse proxy
Requires=mmt-app-web.service
After=mmt-app-web.service

[Container]
ContainerName=mmt-nginx
Image=ghcr.io/asr4memory/mmt-nginx:0.3.0
Network=mmt.network
# Reached only through the front proxy (front-proxy/), on a loopback port that
# differs per instance and matches front-proxy/nginx.conf. Without the front
# proxy, publish 80:8080 and 443:8443 instead.
PublishPort=127.0.0.1:8443:8444
Volume=%h/mmt/user_files:/srv/user_files:ro
Volume=%h/mmt/tls:/etc/nginx/tls:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
