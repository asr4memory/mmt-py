# The values are examples and must be adjusted on the host.

[Unit]
Description=MMT reverse proxy

[Container]
ContainerName=mmt-nginx
Image=ghcr.io/asr4memory/mmt-nginx:0.2.0
Network=mmt.network
PublishPort=8080:8080
PublishPort=8443:8443
Volume=/srv/mmt/user_files:/srv/user_files:ro
Volume=/srv/mmt/tls:/etc/nginx/tls:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
