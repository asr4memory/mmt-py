#!/bin/bash

[[ $# -eq 1 ]] || {
    echo "usage: create-mmt-ner TAG"
    exit 1
}

image="ghcr.io/asr4memory/mmt-ner:$1"
container="mmt-ner"
: "${CELERY_BROKER_URL:?set CELERY_BROKER_URL to the Redis URL the app uses}"
: "${CELERY_RESULT_BACKEND:?set CELERY_RESULT_BACKEND to the Redis URL the app uses}"
echo "Running image $image as $container ..."

# The health check is configured per deployment rather than in the image,
# because podman does not apply an image HEALTHCHECK. The dev environment sets
# the same values in docker/docker-compose.yml.
podman run \
       --restart always \
       --init \
       --detach \
       --memory 3000m \
       --memory-swap 3000m \
       --cpu-shares 256 \
       --health-cmd 'celery -A tasks inspect ping -d ner@$(hostname)' \
       --health-interval 30s \
       --health-timeout 30s \
       --health-start-period 30s \
       --health-retries 3 \
       --env CELERY_BROKER_URL \
       --env CELERY_RESULT_BACKEND \
       --name="$container" \
       "$image"
