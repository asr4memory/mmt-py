server {
    listen 8080;
    server_name _;

    # The application limits the size of an upload chunk itself, so nginx
    # imposes no limit of its own. Request bodies are forwarded as they
    # arrive, except on the upload chunk route below.
    client_max_body_size 0;
    proxy_request_buffering off;

    location /internal-media/ {
        internal;
        alias /srv/user_files/;
    }

    # A gunicorn thread is held while it reads a request body. nginx stores
    # each upload chunk, at most 10 MB, in its temporary directory and opens
    # the upstream connection only after the client has sent the whole body,
    # so a slow uplink does not hold a thread for the transfer.
    location ~ ^/uploaded-files/\d+/upload/\d+/$ {
        proxy_request_buffering on;
        proxy_pass http://${MMT_WEB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location / {
        proxy_pass http://${MMT_WEB_UPSTREAM};
        proxy_http_version 1.1;
        # $http_host keeps the port, $host drops it. Django builds the
        # origin it compares against the browser's Origin header from the Host
        # header, so dropping the port fails the CSRF check on any port but 80.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
