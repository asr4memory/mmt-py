[Unit]
Description=MMT Celery worker with beat
Requires=mmt-mariadb.service mmt-redis.service
After=mmt-mariadb.service mmt-redis.service

[Container]
ContainerName=mmt-app-celery
# The Celery worker is named after the host name, which the health check uses.
HostName=mmt-app-celery
Image=ghcr.io/asr4memory/mmt-app:2026.10.22
Network=mmt.network
RunInit=true
EnvironmentFile=%h/mmt/app.env
WorkingDir=/app/django-app
Volume=/srv/mmt/user_files:/app/django-app/user_files
Exec=celery --app=mmt worker --hostname=celery@mmt-app-celery --concurrency=2 --beat --loglevel=INFO
HealthCmd=celery --app=mmt inspect ping --destination=celery@mmt-app-celery
PodmanArgs=--memory 768m --memory-swap 1280m --cpu-shares 512

[Service]
Restart=always

[Install]
WantedBy=default.target
