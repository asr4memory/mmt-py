# db.env holds MARIADB_ROOT_PASSWORD and MARIADB_PASSWORD, the password of the
# user mmt, which is also DATABASE_PASSWORD in env.list. It is not committed.

[Unit]
Description=MMT database

[Container]
ContainerName=mmt-db
Image=docker.io/library/mariadb:11
Network=mmt.network
Volume=mmt-db.volume:/var/lib/mysql
Environment=MARIADB_DATABASE=mmt
Environment=MARIADB_USER=mmt
EnvironmentFile=%h/mmt/db.env
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthStartPeriod=60s

[Service]
Restart=always

[Install]
WantedBy=default.target
