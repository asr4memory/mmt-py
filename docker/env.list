# Common environment variables loaded by all containers.
CELERY_BROKER_URL=redis://host
DATABASE_URL=mysql://user:password@host:3306/database
DJANGO_ENV=production
ALLOWED_HOSTS=127.0.0.1
CSRF_TRUSTED_ORIGINS=127.0.0.1
EMAIL_FROM=noreply@example.com
EMAIL_URL=smtp://mail.example.com
PGID=101
PUID=100
SECRET_KEY=secret-key
SENTRY_URL=
OPENID_CONNECT_SERVER_URL=https://sso.example.com
OPENID_CONNECT_SECRET=secret
TMPDIR=/app/django-app/user_files/_tmp
