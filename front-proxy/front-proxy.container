# Runs as its own user (front-proxy), not as the users of the MMT instances.
# The domains and ports in nginx.conf are examples and must be adjusted on the host.

[Unit]
Description=Front proxy that forwards each domain to its MMT instance

[Container]
ContainerName=front-proxy
Image=docker.io/library/nginx:1.29
# The host network lets the proxy listen on the ports 80 and 443 of the host
# and connect to the loopback ports that the instances publish.
Network=host
Volume=%h/front-proxy/nginx.conf:/etc/nginx/nginx.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
