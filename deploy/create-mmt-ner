#!/bin/bash

[[ $# -eq 1 ]] || {
    echo "usage: create-mmt-ner TAG"
    exit 1
}

image="ghcr.io/asr4memory/mmt-ner:$1"
container="mmt-ner"
ner_port="${MMT_NER_PORT:?set MMT_NER_PORT to the host port for the NER service}"
echo "Running image $image as $container ..."

# The health check is configured per deployment rather than in the image,
# because podman does not apply an image HEALTHCHECK. The dev environment sets
# the same values in docker/docker-compose.yml.
podman run \
       --restart always \
       --init \
       --detach \
       --memory 3000m \
       --memory-swap 3000m \
       --health-cmd 'curl -fsS http://localhost:8000/health' \
       --health-interval 30s \
       --health-timeout 30s \
       --health-start-period 30s \
       --health-retries 3 \
       --publish "$ner_port:8000" \
       --name="$container" \
       "$image"
