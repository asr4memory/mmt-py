#!/bin/bash

[[ $# -eq 1 ]] || {
    echo "usage: create-mmt-nginx TAG"
    exit 1
}

image="ghcr.io/asr4memory/mmt-nginx:$1"
container="mmt-nginx"
data_dir="${MMT_DATA_DIR:?set MMT_DATA_DIR to the host user-files directory}"
http_port="${MMT_HTTP_PORT:?set MMT_HTTP_PORT to the host port for the proxy}"
web_port="${MMT_WEB_PORT:?set MMT_WEB_PORT to the host port of the web app}"
echo "Running image $image as $container ..."

# The web container is not on a shared network with this one; it publishes its
# port on the host, which the container reaches as host.containers.internal.
# NGINX_ENVSUBST_FILTER keeps the startup envsubst step to MMT_* so nginx's own
# variables in the template survive it.
podman run \
       --restart always \
       --detach \
       --publish "$http_port:8080" \
       --volume "$data_dir:/srv/user_files:ro" \
       --env "MMT_WEB_UPSTREAM=host.containers.internal:$web_port" \
       --env NGINX_ENVSUBST_FILTER='^MMT_' \
       --name="$container" \
       "$image"
