{
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    // biome.json and node_modules live in app/, not at the workspace root, so
    // the extension is pointed at both explicitly. Without this it falls back
    // to its own biome binary, whose formatting differs from the version the
    // "assets:format" script runs.
    "biome.configurationPath": "./app/biome.json",
    "biome.lsp.bin": {
        "linux-x64": "./app/node_modules/@biomejs/cli-linux-x64/biome",
        "linux-arm64": "./app/node_modules/@biomejs/cli-linux-arm64/biome",
        "darwin-arm64": "./app/node_modules/@biomejs/cli-darwin-arm64/biome",
        "darwin-x64": "./app/node_modules/@biomejs/cli-darwin-x64/biome",
        "win32-x64": "./app/node_modules/@biomejs/cli-win32-x64/biome.exe"
    },
    // The djLint extension formats Django templates on save. It is pointed at
    // the interpreter of the app's virtual environment, which is where djlint
    // is installed; its own venv detection looks next to the workspace root,
    // where there is none. The formatting options are not repeated here:
    // djlint reads them from app/pyproject.toml, which is also what the CI
    // check and a manual run use. useEditorIndentation is therefore off, as it
    // would override the configured indent with the tab size of the editor.
    "djlint.pythonPath": "./app/.venv/bin/python",
    "djlint.useVenv": false,
    "djlint.useEditorIndentation": false,
    "[html]": {
        "editor.defaultFormatter": "monosans.djlint"
    },
    "[django-html]": {
        "editor.defaultFormatter": "monosans.djlint"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    }
}
