# The values are examples and must be adjusted on the host.

[Unit]
Description=MMT reverse proxy
Requires=mmt-app-web.service
After=mmt-app-web.service

[Container]
ContainerName=mmt-nginx
Image=ghcr.io/asr4memory/mmt-nginx:0.2.0
Network=mmt.network
PublishPort=80:8080
PublishPort=443:8443
Volume=/srv/mmt/user_files:/srv/user_files:ro
Volume=%h/mmt/tls:/etc/nginx/tls:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
